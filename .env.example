# ==============================================================================
# Wills Agent — Environment Configuration Template (.env.example)
# Never commit real private keys or secrets to version control.
# ==============================================================================

# 1. Google Gemini AI API Configuration
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# 2. Agent Wallet (Base Sepolia Testnet)
# Generated automatically on initial setup via UI, or specify an existing testnet key:
WALLET_PRIVATE_KEY=

# 3. Estate / Wills Vault Smart Contract (Base Sepolia)
# Deployed vault address and token asset configuration
VAULT_ADDRESS=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
OWNER_ADDRESS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# 4. Keeper & Sellers
KEEPER_PRIVATE_KEY=
SELLER_PAY_TO=

# 5. x402 Protocol & Facilitator
FACILITATOR_URL=https://x402.org/facilitator

# 6. Database & Persistence (libSQL / SQLite)
DATABASE_URL=file:local.db

# 7. Application & Security Flags
DEMO_MODE=true
APP_PASSPHRASE=
CRON_SECRET=
BASESCAN_API_KEY=
